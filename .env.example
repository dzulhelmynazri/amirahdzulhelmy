# Atlas monorepo — copy to .env at the repo root, then symlink into each app.
#   bun run env:link
#
# Or manually:
#   cp .env.example .env
#   ln -sf ../../.env apps/disruption-guard/.env

# --- Optional: eve build without full secrets ---
# SKIP_ENV_VALIDATION=1

# --- Eve model (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=

# --- Atlas Flight Booking API ---
ATLAS_API_URL=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# --- Database ---
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# --- OAuth (Better Auth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Composio (journey-concierge; required by @atlas/env schema) ---
COMPOSIO_API_KEY=
# Local eve evals authenticate as local-dev; set this to the Better Auth user
# id that has Google Calendar connected so calendar evals can write events.
# COMPOSIO_EVAL_USER_ID=XXJZYMrZxQzv6Z5djKMETLoRGqXwuBEz

# --- Object storage (@atlas/env schema) ---
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENCRYPTION_KEY=
S3_REGION=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- disruption-guard: scheduled alerts (Resend) ---
DISRUPTION_OPS_EMAIL=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Atlas <alerts@your-verified-domain.com>

# --- Optional: disruption-guard channels ---
# RESEND_WEBHOOK_SECRET=

# --- Upstash Redis (disruption-guard AgentKit: memory + chat history) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- travel-sentinel: Firecrawl MCP (destination intelligence) ---
FIRECRAWL_API_KEY=

# Optional. Overrides the model every agent runs on. Unset = alibaba/qwen3.7-flash.
#
# Gateway list price per million tokens, measured 2026-08-28:
#   alibaba/qwen3.7-flash        in 0.030   out 0.130    (the default)
#   zai/glm-5.3-flash            in 0.150   out 0.500    5x the default
#   minimax/minimax-m3-free      in 0.000   out 0.000    1M context, tools work
#   minimax/minimax-m2.7-free    in 0.000   out 0.000
#   poolside/laguna-s-2.1-free   in 0.000   out 0.000
#
# The three "-free" models are listed at zero and were verified end to end:
# they call tools and complete a real search. A run still reported a non-zero
# costUsd, so check the Vercel dashboard before trusting free to mean free.
# ATLAS_AGENT_MODEL=minimax/minimax-m3-free
